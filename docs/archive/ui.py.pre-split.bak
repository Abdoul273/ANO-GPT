# HudCanvas dessine exclusivement avec QPainter : il n'utilise ni shader, ni
# texture, ni appel OpenGL. Le faire hériter de QOpenGLWidget créait pourtant
# un contexte QRhi/Mesa et faisait passer chaque rafraîchissement par le pilote
# i915. Sur certaines versions de Mesa (notamment avec les Intel Skylake), ce
# chemin peut corrompre le tas natif et le processus finit alors par tomber en
# SIGSEGV dans un autre thread (souvent OpenSSL), sans traceback Python utile.
#
# Le backend raster QWidget est donc le choix sûr par défaut. L'ancien chemin
# reste disponible pour diagnostic avec ANOGPT_USE_OPENGL=1.
_GL_BASE = QWidget
if os.environ.get("ANOGPT_USE_OPENGL", "").strip().lower() in {
    "1", "true", "yes", "on",
}:
    try:
        from PyQt6.QtOpenGLWidgets import QOpenGLWidget
        _GL_BASE = QOpenGLWidget
    except ImportError:
        pass

try:
    from PyQt6.QtWebEngineWidgets import QWebEngineView
    from PyQt6.QtWebEngineCore import QWebEngineSettings
    _WEBENGINE = True
except ImportError:
    _WEBENGINE = False

try:
    from PyQt6.QtMultimedia import QAudioOutput, QMediaPlayer, QVideoSink
    _QTMULTIMEDIA = True
except ImportError:
    _QTMULTIMEDIA = False

def _base_dir() -> Path:
    if getattr(sys, "frozen", False):
        return Path(sys.executable).parent
    return Path(__file__).resolve().parent

BASE_DIR   = _base_dir()
CONFIG_DIR = BASE_DIR / "config"
API_FILE   = CONFIG_DIR / "api_keys.json"


def _read_full_config() -> dict:
    """Read api_keys.json config dict. Returns {} on any error."""
    try:
        return json.loads(API_FILE.read_text(encoding="utf-8"))
    except Exception:
        return {}


